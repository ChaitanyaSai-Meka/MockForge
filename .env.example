# Public Supabase project settings (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Required in Phase 3 for the public mock runtime and request logging.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Canonical application origin. Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
